{
  "name": "ambery-app",
  "private": true,
  "version": "0.1.0-alpha0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "kitchen-sink:dev": "vite",
    "kitchen-sink:build": "vite build --mode kitchen-sink",
    "kitchen-sink:preview": "vite preview --mode kitchen-sink",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "pretest": "cargo build -p ambery-case --manifest-path ../../Cargo.toml",
    "test": "node test/run-frontend-case.mjs",
    "tauri:build:no-sidecar": "tauri build --config tauri/src-tauri/tauri.no-sidecar.conf.json",
    "tauri:dev:no-sidecar": "tauri dev --config tauri/src-tauri/tauri.no-sidecar.conf.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/ws": "^8.18.1",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "ws": "^8.21.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  }
}
