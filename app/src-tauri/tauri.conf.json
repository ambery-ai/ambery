{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ambery",
  "version": "0.1.0",
  "identifier": "dev.ambery.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
