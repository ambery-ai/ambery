{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "terminal-overseer",
  "version": "0.1.0",
  "identifier": "dev.overseer.terminal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "Terminal Overseer",
        "url": "index.html",
        "width": 80,
        "height": 40,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "cards",
        "title": "cards",
        "url": "index.html#cards",
        "width": 300,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": true,
        "resizable": false
      },
      {
        "label": "menu",
        "title": "menu",
        "url": "index.html#menu",
        "width": 380,
        "height": 560,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false
      },
      {
        "label": "chat",
        "title": "chat",
        "url": "index.html#chat",
        "width": 320,
        "height": 380,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
