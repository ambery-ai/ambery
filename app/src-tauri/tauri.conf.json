        "url": "index.html",
        "width": 116,
        "height": 40,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "menu",
        "title": "menu",
        "url": "index.html#menu",
        "width": 380,
        "height": 560,
