        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false
      },
      {
        "label": "chat",
        "title": "chat",
        "url": "index.html#chat",
        "width": 320,
        "height": 380,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false
      },
      {
        "label": "shelf",
        "title": "shelf",
        "url": "index.html#shelf",
        "width": 240,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"],
    "externalBin": ["../../sidecar/bin/Release/net9.0-windows/win-x64/publish/ambery-uia-sidecar.exe"]
  }
}
